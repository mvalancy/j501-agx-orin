  "opening_notes": {
    "front_audio": "CON1/CON2: shared clean opening for adjacent 3.5 mm audio jacks; source shells 151/152 plus plug allowance.",
    "front_network_power": "J5/J12 RJ45, LED4 and J2 power. Single clean rectangular cluster because closely spaced housings leave weak webs.",
    "front_gmsl": "Only on GMSL panel. Two mini-FAKRA candidate connector mouths, common rectangular window. XY remains provisional.",
    "rear_terminal": "J25 20-pin industrial terminal, not ventilation.",
    "rear_hdmi_usb": "J8 HDMI + J7 dual USB-A + J26 vertical USB-A. Includes restored J7 source shell; J26 source height is a placeholder and corrected footprint envelope is provisional. Rear web is 4 mm minimum. Opening follows mating access; housing flanges sit behind the bezel. Cable overmold fit unconfirmed.",
    "rear_usb_c_pair": "J9 and J10 genuine underside USB-C ports, grouped in one straight slot. Starts at X112.4 for a 4 mm web; verify metal plug and overmold against this service aperture.",
    "front_sim": "J18 nano-SIM is internal service access. No opening in either front panel; remove front panel to service. Former slot misidentified as USB-C is removed.",
    "front_audio_gmsl": "One clean shared window for audio and both mini-FAKRA mouths; avoids thin strips between adjacent connectors. Only GMSL variant."
  }
